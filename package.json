{
  "name": "mongoose-to-erd",
  "version": "1.0.17",
  "description": "Convert your mongoose schema to Entity Relationship Diagram Easily",
  "keywords": [
    "mongoose",
    "mongoose to erd",
    "erd",
    "entity relationship diagram",
    "database",
    "mongodb"
  ],
  "homepage": "https://faraasat.github.io/mongoose-to-erd",
  "bugs": {
    "url": "https://github.com/faraasat/mongoose-to-erd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faraasat/mongoose-to-erd.git"
  },
  "license": "MIT",
  "author": "Farasat Ali <63093876+faraasat@users.noreply.github.com>",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/faraasat"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "standard-version",
    "prepublishOnly": "npm run typecheck && npm run test -- --run && npm run build",
    "example:dev": "npm run build && npm --prefix example install && npm --prefix example run dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "peerDependencies": {
    "mongoose": ">=5.2.9"
  },
  "dependencies": {
    "@terrastruct/d2": "^0.1.21"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "standard-version": "^9.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "mongoose": "^8.18.0",
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.10.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
